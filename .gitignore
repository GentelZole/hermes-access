# Secrets — NEVER commit
.secrets/
*.keystore
*.jks
signing.properties

# Local environment (keep the template, ignore the real thing)
.env
.env.*
!.env.example

# app/android/ IS committed (bare-workflow native project: signing, icons,
# network-security xml). Only build outputs below are ignored.

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Build artifacts
dist/
app/android/app/build/
app/android/build/
app/android/.gradle/
app/node_modules/
app/.expo/
*.apk
*.aab

# Keep the committed APK? No — releases go via GitHub Releases, not git.

# Misc
.DS_Store
*.log
app/android/**/.cxx/
app/android/app/debug.keystore
