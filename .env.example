# ─────────────────────────────────────────────────────────────────────────────
# Hermes Access — environment template.
# Copy to .env and edit. NEVER commit .env, and never paste a real key anywhere.
# ─────────────────────────────────────────────────────────────────────────────

# ── Hermes gateway (server side, read by ~/.hermes/.env on the gateway host) ──
# The bearer token the app receives when it pairs. Generate a strong random value.
# *** is a placeholder — replace it.
API_SERVER_KEY=***
# Enable the gateway API Server and bind it to a reachable interface.
API_SERVER_ENABLED=true
API_SERVER_HOST=<your reachable interface, e.g. your Tailscale address>
API_SERVER_PORT=8642

# ── Pairing bridge (read by bridge/server.py) ────────────────────────────────
# Where the one-time code table is stored (created with mode 0600).
BRIDGE_STATE=./.secrets/bridge-state.json
# The baseUrl handed to a device when it redeems a code.
BRIDGE_GATEWAY_URL=http://127.0.0.1:8642
# Label shown in the app for this gateway.
BRIDGE_LABEL=hermes-agent
# Where uvicorn binds. Use a tailnet address (or nginx in front) for phone-first
# pairing; loopback is the safe default.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8661

# ── App build-time defaults (read by Expo; EXPO_PUBLIC_* is inlined at build) ─
# The pairing screen's Bridge URL field is editable on every install, so this is
# only for making your bridge the compiled-in default in your own fork.
# DEFAULT_BRIDGE in app/src/app/setup.tsx reads this and is empty by default.
EXPO_PUBLIC_DEFAULT_BRIDGE=https://your-domain.example/pair